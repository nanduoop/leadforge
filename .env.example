# LeadForge environment. Copy to .env and fill in what you need.
#
# Nothing here is required for a local run where a human has already run
# `composio link <app>` in a browser. It matters for headless environments —
# a cloud container, Codex, CI — where no one can click through OAuth.

# --- Composio: the one that unlocks headless runs ------------------------------
# Every business-app call (Firecrawl, Google Sheets, NeverBounce, HubSpot) goes
# through Composio, so this is what a container needs to act as you.
#
# A human does the OAuth once, from any browser, on any machine:
#     composio login
#     composio link firecrawl
#
# After that the connection lives in the Composio account, not on that machine.
# Give a headless environment this key and it inherits every app already linked:
#     composio login --user-api-key "$COMPOSIO_API_KEY"
#
# Get it from https://app.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=

# --- Browserbase: optional -----------------------------------------------------
# Only used for JS-heavy or gated team pages that Firecrawl cannot read.
# Discovery works without it; you will just lose a few contacts.
BROWSERBASE_API_KEY=

# --- Behaviour -----------------------------------------------------------------
# Cap on discovery search queries. Each one costs Firecrawl credits, so lower
# this before a first run somewhere new.
LEADFORGE_LIMIT=60

# Where the local UI binds, if you use it. Irrelevant to headless runs.
LEADFORGE_HOST=127.0.0.1
LEADFORGE_PORT=7842
